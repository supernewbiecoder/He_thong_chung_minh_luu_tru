# ═══════════════════════════════════════════════════════════════════════════
#  MÁY CHỦ DÙNG CHUNG — đọc trước khi chạy
#
#  node-blockchain đang chạy celestia-node (26658), sp1-blobstream,
#  orchestrator-relayer, nitro/orbit (8545/8547), các stack dal-*.
#  Mọi cổng dưới đây đã dời sang dải 18xxx để không đụng.
#
#  Nếu preflight vẫn báo xung đột thì đổi cả dải, ví dụ 19xxx.
# ═══════════════════════════════════════════════════════════════════════════

COMPOSE_PROJECT_NAME=engram-sim

ENGRAM_PORT_ANVIL=18545
ENGRAM_PORT_DAMOCK=18658
ENGRAM_PORT_CELESTIA=18659
ENGRAM_PORT_PROV_A=18101
ENGRAM_PORT_PROV_B=18102
ENGRAM_PORT_WORK_1=18201
ENGRAM_PORT_WORK_2=18202
ENGRAM_PORT_AGG=18301
ENGRAM_PORT_CLIENT=18401
ENGRAM_PORT_WATCH=18501

# [CHỐT A2-c] Ba chế độ: local | mocha-anvil | mocha-sepolia
CHAIN_MODE=local
ENGRAM_PROFILE=sim

# [CHỐT C3-a] Quy mô mô phỏng ban đầu
N_DEALS=20
N_EPOCHS=3
N_SHARDS=2

# Chỉ cần khi CHAIN_MODE=mocha-*  — địa chỉ Celestia của từng nút.
# [SPEC §J.2.1] Đây là neo chống mạo danh blob: worker lọc theo trường signer
# trong share v1, và đồng thuận Celestia bảo đảm nó không giả được.
PROVIDER_A_CELESTIA_ADDR=celestia1aaaa
PROVIDER_B_CELESTIA_ADDR=celestia1bbbb

# Chỉ cần khi CHAIN_MODE=mocha-sepolia
SEPOLIA_RPC=
BLOBSTREAM_ADDR=
